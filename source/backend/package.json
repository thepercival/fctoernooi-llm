{
  "name": "fctoernooi-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Simple Node 22 TypeScript app to display runtime app settings",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "db:start": "docker compose -f ../../infra/mongodb/docker-compose.yml up -d",
    "db:stop": "docker compose -f ../../infra/mongodb/docker-compose.yml down",
    "generate": "openapi-typescript ../../infra/openapi.yaml -o src/openapi.gen.ts",
    "build": "npm run generate && tsc -p tsconfig.json && cp ../../infra/openapi.yaml dist/openapi.yaml",
    "start": "node dist/server.js",
    "dev": "npm run generate && tsx src/server.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-openapi-validator": "^5.3.7",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.17.0",
    "@scalar/express-api-reference": "^0.4.192"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "openapi-typescript": "^7.6.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
