# Copy this file to .env for local development.
# Required: a SQL connection string variable (choose one)
# OdsDbConnection is recommended for local dev.

PORT=8080

# Option 1 (recommended local): standard SQL auth connection string
OdsDbConnection=Server=tcp:<server>.database.windows.net,1433;Initial Catalog=<database>;User ID=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# Option 2 (local interactive Entra login)
# OdsDbConnection=Server=tcp:<server>.database.windows.net,1433;Initial Catalog=<database>;Authentication=Active Directory Interactive;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# Optional when tenant/app selection is required for interactive login
# AZURE_TENANT_ID=<tenant-guid>
# AZURE_CLIENT_ID=<client-id>

MONGODB_URI=mongodb://localhost:27017/fctoernooi

