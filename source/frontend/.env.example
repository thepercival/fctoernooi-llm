# Copy this file to .env for local development of the Express server (npm start after npm run build).
PORT=8080

# Base URL of the FCToernooi API, called from the browser (APIM gateway in Azure, or http://localhost:8080 for the local backend).
# Injected into the app at runtime through /config.js.
FCTOERNOOI_API_BASEURL=http://localhost:8080
