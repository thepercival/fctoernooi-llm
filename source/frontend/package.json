{
  "name": "fctoernooi-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Server-rendered Node TypeScript frontend for FCToernooi: public tournaments, accounts and \"mijn toernooien\"",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build:css": "sass --quiet-deps --silence-deprecation=import,global-builtin,color-functions,if-function,slash-div --no-source-map --style=compressed src/sass/main.scss dist/public/styles.css",
    "build:assets": "node -e \"require('fs').cpSync('public','dist/public',{recursive:true})\"",
    "build": "tsc -p tsconfig.json && npm run build:css && npm run build:assets",
    "start": "node dist/server.js",
    "dev": "npm run build:css && npm run build:assets && tsx src/server.ts"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "dotenv": "^17.4.2",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "bootstrap": "^5.3.8",
    "sass": "^1.106.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
