{
  "name": "fctoernooi-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "FCToernooi Angular frontend (Bootstrap 5 / ng-bootstrap, Bootswatch Sandstone), served by a small Express server",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "ng": "ng",
    "start": "node dist/server.js",
    "serve": "ng serve -c dev-nl",
    "build": "ng build -c prod,nl && tsc -p server/tsconfig.json",
    "build:dev": "ng build -c dev-nl && tsc -p server/tsconfig.json",
    "extract-i18n": "ng extract-i18n"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@angular/build": "^22.0.4",
    "@angular/cli": "^22.0.4",
    "@angular/common": "^22.0.4",
    "@angular/compiler": "^22.0.4",
    "@angular/compiler-cli": "^22.0.4",
    "@angular/core": "^22.0.4",
    "@angular/forms": "^22.0.4",
    "@angular/localize": "^22.0.4",
    "@angular/platform-browser": "^22.0.4",
    "@angular/router": "^22.0.4",
    "@fortawesome/angular-fontawesome": "^5.0",
    "@fortawesome/fontawesome-svg-core": "^7.0",
    "@fortawesome/free-brands-svg-icons": "^7.0",
    "@fortawesome/free-regular-svg-icons": "^7.0",
    "@fortawesome/free-solid-svg-icons": "^7.0",
    "@ng-bootstrap/ng-bootstrap": "^21.0",
    "@popperjs/core": "^2.11.8",
    "@types/express": "^4.17.21",
    "@types/node": "^26.0",
    "bootstrap": "^5.0",
    "rxjs": "^7.6",
    "tslib": "^2.6",
    "typescript": "^6.0.3"
  }
}
