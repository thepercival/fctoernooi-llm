{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "logAnalyticsWorkspace": {
            "value": {
                "name": "lw-core"
            }
        },
        "keyVault": {
            "value": {
                "name": "kv-cdk-v3"
            }
        },
        "openaiAccount": {
            "value": {
                "name": "ais-cdk"
            }
        },
        "openaiProject": {
            "value": {
                "name": "aisp-fctoernooi",
                "deploy": {
                    "dev": true,
                    "acc": true,
                    "prd": true
                },
                "description": "For Machine Learning in FCToernooi",
                "roleAssignments": [
                    {
                        "principalId": null,
                        "principalIdVarName": "entraAdminPrincipalId",
                        "principalType": "User",
                        "roleName": "Cognitive Services OpenAI User",
                        "usersDescription": "Application managed identities, developers, end users",
                        "roleDefinitionId": "5e0bd9bd-7b93-4f28-af87-19fc36ad61bd"
                    },
                    {
                        "principalId": null,
                        "principalIdVarName": "entraAdminPrincipalId",
                        "principalType": "User",
                        "roleName": "Cognitive Services OpenAI Contributor",
                        "usersDescription": "AI engineers, ML engineers, project admins",
                        "roleDefinitionId": "a001fd3d-188f-4b5d-821b-7da978bf7442"
                    }
                ]
            }
        },
        "apim": {
            "value": {
                "name": "apim-cdk"
            }
        },
        "appServicePlan": {
            "value": {
                "name": "asp-fctoernooi",
                "sku": {
                    "dev": {
                        "name": "B2",
                        "tier": "Basic",
                        "capacity": 1
                    },
                    "acc": {
                        "name": "B2",
                        "tier": "Basic",
                        "capacity": 1
                    },
                    "prd": {
                        "name": "S1",
                        "tier": "Standard",
                        "capacity": 1
                    }
                }
            }
        },
        "applicationInsights": {
            "value": {
                "name": "appins-cdk"
            }
        },
        "appServiceBackend": {
            "value": {
                "name": "as-fctoernooi-api",
                "linuxFxVersion": "NODE|24-lts",
                "kind": "app,linux"
            }
        },
        "apiBackend": {
            "value": {
                "name": "fctoernooi-api",
                "openapiLink": "https://raw.githubusercontent.com/thepercival/fctoernooi-llm/feature/dev-deploy-on-push/infra/openapi.yaml",
                "version": "v1",
                "backendName": "fctoernooi-api-backend",
                "backendDescription": "FCToernooi REST API App Service",
                "versionSet": {
                    "name": "fctoernooi-api-versionset",
                    "properties": {
                        "displayName": "FCToernooi API",
                        "versioningScheme": "Segment"
                    }
                },
                "properties": {
                    "displayName": "FCToernooi API",
                    "path": "fctoernooi-api",
                    "apiVersion": "v1",
                    "protocols": [
                        "https"
                    ],
                    "subscriptionRequired": true,
                    "format": "openapi"
                },
                "product": {
                    "name": "fctoernooi-api-product",
                    "properties": {
                        "displayName": "FCToernooi API",
                        "description": "Tournament management REST API",
                        "subscriptionRequired": true,
                        "approvalRequired": false,
                        "state": "published"
                    },
                    "groups": [
                        "Developers"
                    ]
                }
            }
        },
        "database": {
            "value": {
                "host": "db.cdkdev.nl",
                "name": {
                    "dev": "fctoernooi-dev",
                    "acc": "fctoernooi-acc",
                    "prd": "fctoernooi"
                }
            }
        }
    }
}