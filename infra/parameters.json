{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "logAnalyticsWorkspace": {
            "value": {
                "name": "lw-core"
            }
        },
        "keyVault": {
            "value": {
                "name": "kv-cdk-v3"
            }
        },
        "openaiAccount": {
            "value": {
                "name": "ais-cdk"
            }
        },
        "openaiProject": {
            "value": {
                "name": "aisp-fctoernooi",
                "deploy": {
                    "dev": true,
                    "acc": true,
                    "prd": true
                },
                "description": "For FCToernooi ChatApp",
                "roleAssignmentTemplates": [
                    {
                        "principalName": "cdkdev",
                        "principalType": "User",
                        "roleName": "Foundry User",
                        "roleDefinitionId": "53ca6127-db72-4b80-b1b0-d745d6d5456d"
                    }
                ]         
            }
        },
        "apim": {
            "value": {
                "name": "apim-cdk"
            }
        },
        "appServicePlan": {
            "value": {
                "name": "asp-fctoernooi",
                "sku": {
                    "dev": {
                        "name": "B2",
                        "tier": "Basic",
                        "capacity": 1
                    },
                    "acc": {
                        "name": "B2",
                        "tier": "Basic",
                        "capacity": 1
                    },
                    "prd": {
                        "name": "S1",
                        "tier": "Standard",
                        "capacity": 1
                    }
                }
            }
        },
        "applicationInsights": {
            "value": {
                "name": "appins-cdk"
            }
        },
        "appServiceBackend": {
            "value": {
                "name": "as-fctoernooi-api",
                "linuxFxVersion": "NODE|24-lts",
                "kind": "app,linux"
            }
        },
        "appServiceFrontend": {
            "value": {
                "name": "as-fctoernooi-frontend",
                "linuxFxVersion": "NODE|24-lts",
                "kind": "app,linux",
                "apiBaseUrl": {
                    "dev": "https://apim-cdk-dev.azure-api.net/fctoernooi-api/v1",
                    "acc": "https://apim-cdk-acc.azure-api.net/fctoernooi-api/v1",
                    "prd": "https://apim-cdk-prd.azure-api.net/fctoernooi-api/v1"
                }
            }
        },
        "apiBackend": {
            "value": {
                "name": "fctoernooi-api",
                "openapiLink": "https://raw.githubusercontent.com/thepercival/fctoernooi-llm/feature/dev-deploy-on-push/infra/openapi.yaml",
                "version": "v1",
                "backendName": "fctoernooi-api-backend",
                "backendDescription": "FCToernooi REST API App Service",
                "versionSet": {
                    "name": "fctoernooi-api-versionset",
                    "properties": {
                        "displayName": "FCToernooi API",
                        "versioningScheme": "Segment"
                    }
                },
                "properties": {
                    "displayName": "FCToernooi API",
                    "path": "fctoernooi-api",
                    "apiVersion": "v1",
                    "protocols": [
                        "https"
                    ],
                    "subscriptionRequired": false,
                    "format": "openapi"
                },
                "product": {
                    "name": "fctoernooi-api-product",
                    "properties": {
                        "displayName": "FCToernooi API",
                        "description": "Tournament management REST API",
                        "subscriptionRequired": false,
                        "state": "published"
                    },
                    "groups": [
                        "Developers"
                    ]
                }
            }
        },
        "database": {
            "value": {
                "host": "db.cdkdev.nl",
                "name": {
                    "dev": "fctoernooi-dev",
                    "acc": "fctoernooi-acc",
                    "prd": "fctoernooi"
                }
            }
        },
        "mcpServer": {
            "value": {
                "name": "fctoernooi-api-mcp",
                "displayName": "FCToernooi API MCP Server",
                "description": "Exposes the FCToernooi tournament API as MCP tools for AI agents.",
                "path": "fctoernooi-api-mcp"
            }
        }
    }
}