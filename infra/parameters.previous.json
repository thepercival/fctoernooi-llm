{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "openaiAccount": {
            "value": {
                "name": "aoai-cdk",
                "deployOnEnvironment": "dev"
            }
        },
        "openaiProject": {
            "value": {
                "name": "aoai-project-fctoernooi",
                "description": "For Machine Learning in FCToernooi",
                "projectRoleAssignments": [
                    {
                        "projectPrincipalId": null,
                        "projectPrincipalType": "ServicePrincipal",
                        "roleName": "Cognitive Services OpenAI User",
                        "usersDescription": "Application managed identities, developers, end users",
                        "roleDefinitionId": "5e0bd9bd-7b93-4f28-af87-19fc36ad61bd"
                    },
                    {
                        "projectPrincipalId": null,
                        "projectPrincipalType": "ServicePrincipal",
                        "roleName": "Cognitive Services OpenAI Contributor",
                        "usersDescription": "AI engineers, ML engineers, project admins",
                        "roleDefinitionId": "a001fd3d-188f-4b5d-821b-7da978bf7442"
                    }
                ]
            }
        },
        "apim": {
            "value": {
                "name": "apim-cdk"
            }
        },
        "appServicePlan": {
            "value": {
                "name": "asp-fctoernooi",
                "sku": {
                    "name": "B2",
                    "tier": "Basic",
                    "capacity": 1
                }
            }
        },
        "applicationInsights": {
            "value": {
                "name": "appi-cdk"
            }
        },
        "appServiceBackend": {
            "value": {
                "name": "as-fctoernooi-api",
                "linuxFxVersion": "NODE|22-lts"
            }
        },
        "appServiceFrontend": {
            "value": {
                "name": "as-fctoernooi-frontend",
                "linuxFxVersion": "NODE|22-lts",
                "foundryAgentId": ""
            }
        },
        "apiBackend": {
            "value": {
                "name": "fctoernooi-api",
                "version": "v1",
                "backendName": "fctoernooi-api-backend",
                "backendDescription": "FCToernooi REST API App Service",
                "versionSet": {
                    "name": "fctoernooi-api-versionset",
                    "properties": {
                        "displayName": "FCToernooi API",
                        "versioningScheme": "Segment"
                    }
                },
                "properties": {
                    "displayName": "FCToernooi API",
                    "path": "fctoernooi-api",
                    "apiVersion": "v1",
                    "protocols": [
                        "https"
                    ],
                    "subscriptionRequired": true,
                    "format": "openapi"
                },
                "product": {
                    "name": "fctoernooi-api-product",
                    "properties": {
                        "displayName": "FCToernooi API",
                        "description": "Tournament management REST API",
                        "subscriptionRequired": true,
                        "approvalRequired": false,
                        "state": "published"
                    },
                    "groups": [
                        "Developers"
                    ]
                }
            }
        },
        "apiFrontend": {
            "value": {
                "name": "fctoernooi-frontend",
                "version": "v1",
                "backendName": "fctoernooi-frontend-backend",
                "backendDescription": "FCToernooi Chatbot Frontend App Service",
                "versionSet": {
                    "name": "fctoernooi-frontend-versionset",
                    "properties": {
                        "displayName": "FCToernooi Chatbot",
                        "versioningScheme": "Segment"
                    }
                },
                "properties": {
                    "displayName": "FCToernooi Chatbot",
                    "path": "fctoernooi-frontend",
                    "apiVersion": "v1",
                    "protocols": [
                        "https"
                    ],
                    "subscriptionRequired": true,
                    "format": "openapi"
                },
                "product": {
                    "name": "fctoernooi-frontend-product",
                    "properties": {
                        "displayName": "FCToernooi Chatbot",
                        "description": "AI chatbot frontend backed by an Azure AI Foundry agent",
                        "subscriptionRequired": true,
                        "approvalRequired": false,
                        "state": "published"
                    },
                    "groups": [
                        "Developers"
                    ]
                }
            }
        }
    }
}